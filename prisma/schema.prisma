// Prisma Schema - Lobos G Outlet E-commerce
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. USUÁRIOS E AUTENTICAÇÃO (BACKOFFICE)
// ------------------------------------------------------

enum AdminRole {
  ADMIN       // Acesso total (configurações, taxas, produtos, relatórios)
  EXPEDICAO   // Gestão de pedidos, separação e envio de motoboy
  ATENDIMENTO // Consulta de pedidos e suporte a clientes
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EXPEDICAO)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ------------------------------------------------------
// 2. CATÁLOGO, PRODUTOS E GRADE DE ESTOQUE
// ------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  displayOrder Int      @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id                 String           @id @default(uuid())
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  name               String
  slug               String           @unique
  description        String?          @db.Text
  originalPrice      Decimal?         @db.Decimal(10, 2) // Preço "De" (riscado)
  price              Decimal          @db.Decimal(10, 2) // Preço "Por" atual de venda
  isOutletDiscount   Boolean          @default(false)
  measurementsGuide  Json?            // Tabela com medidas (cm): busto, cintura, altura etc.
  featured           Boolean          @default(false)
  active             Boolean          @default(true)
  images             ProductImage[]
  variants           ProductVariant[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String      @unique // Ex: LOB-CAM-OVZ-BLK-G
  size          String      // P, M, G, GG, XG, 38, 40, etc.
  colorName     String?     // Preto, Branco, Mescla, etc.
  colorHex      String?     // Código hexadecimal para bolinha visual (#000000)
  stockQuantity Int         @default(0)
  priceOverride Decimal?    @db.Decimal(10, 2) // Caso algum tamanho especial tenha preço diferente
  barcode       String?     // Código EAN/Barras se houver
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@index([size])
  @@map("product_variants")
}

// ------------------------------------------------------
// 3. LOGÍSTICA LOCAL & ZONAS DE ENTREGA (SEM AGREGADOR)
// ------------------------------------------------------

enum DeliveryMethod {
  PICKUP   // Retirada no balcão da loja física (Jardim Novo Mundo)
  MOTOBOY  // Entrega expressa por motoboy regional
}

model DeliveryZone {
  id                    String   @id @default(uuid())
  name                  String   // Ex: "Região Leste / Jardim Novo Mundo", "Goiânia Central", "Aparecida"
  cepPrefixes           String[] // Lista de prefixos de CEP atendidos (ex: ["74703", "74705", "74710"])
  neighborhoods         String[] // Nomes de bairros inclusos
  deliveryFee           Decimal  @db.Decimal(10, 2) // Taxa de entrega fixa (ex: R$ 12.00)
  estimatedDeliveryHours Int     @default(24)       // Prazo estimado em horas
  freeShippingAbove     Decimal? @db.Decimal(10, 2) // Valor mínimo de pedido para frete grátis
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("delivery_zones")
}

model PickupPoint {
  id           String   @id @default(uuid())
  name         String   @default("Loja Física - Lobos G Outlet")
  address      String   // Rua, número, bairro, cidade, CEP
  openingHours String   // Ex: "Seg a Sex: 09h às 19h | Sáb: 09h às 15h"
  instructions String?  // "Apresentar o código do pedido no balcão de retirada"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pickup_points")
}

// ------------------------------------------------------
// 4. PEDIDOS & ITENS DO PEDIDO
// ------------------------------------------------------

enum OrderStatus {
  PENDING           // Aguardando confirmação do pagamento
  PAID              // Pagamento aprovado, pronto para separação
  PREPARING         // Em separação / embalagem no estoque
  READY_FOR_PICKUP  // Pronto para retirada pelo cliente no balcão
  OUT_FOR_DELIVERY  // Em rota com o motoboy
  DELIVERED         // Pedido entregue ao cliente
  CANCELLED         // Cancelado (falta de pagamento ou devolução)
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
}

model Order {
  id                    String         @id @default(uuid())
  orderNumber           String         @unique // Formato amigável: LOB-1001
  status                OrderStatus    @default(PENDING)
  
  // Dados do Cliente
  customerName          String
  customerEmail         String
  customerPhone         String         // WhatsApp com DDD (essencial para entrega e avisos)
  customerCpf           String
  
  // Modalidade de Entrega
  deliveryMethod        DeliveryMethod
  deliveryFee           Decimal        @default(0.00) @db.Decimal(10, 2)
  deliveryZoneName      String?
  
  // Endereço (obrigatório se for MOTOBOY)
  shippingCep           String?
  shippingStreet        String?
  shippingNumber        String?
  shippingComplement    String?
  shippingNeighborhood  String?
  shippingCity          String?        @default("Goiânia")
  shippingState         String?        @default("GO")
  deliveryNotes         String?        // Ponto de referência / Instruções para o motoboy
  
  // Valores do Pedido
  subtotal              Decimal        @db.Decimal(10, 2)
  discountValue         Decimal        @default(0.00) @db.Decimal(10, 2)
  total                 Decimal        @db.Decimal(10, 2)
  
  // Pagamento
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus  @default(PENDING)
  paymentGatewayId      String?        // ID da transação no Mercado Pago / Asaas
  pixQrCode             String?        @db.Text
  pixCopyPaste          String?        @db.Text
  pixExpiresAt          DateTime?
  paidAt                DateTime?

  // Cupom
  couponId              String?
  coupon                Coupon?        @relation(fields: [couponId], references: [id])
  
  items                 OrderItem[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  productName     String         // Snapshot do nome no momento da compra
  sku             String         // Snapshot do SKU
  size            String         // Snapshot do tamanho
  colorName       String?        // Snapshot da cor
  quantity        Int
  unitPrice       Decimal        @db.Decimal(10, 2)
  totalPrice      Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

// ------------------------------------------------------
// 5. CUPONS DE DESCONTO
// ------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique // Ex: LOBOS10, PRIMEIRACOMPRA
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderValue  Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  validUntil     DateTime?
  active         Boolean      @default(true)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("coupons")
}
