# ===================================================
# AMBIENTE - LOBOS G OUTLET E-COMMERCE
# ===================================================

# 1. BANCO DE DADOS (PostgreSQL)
# Exemplo local: postgresql://postgres:senha@localhost:5432/lobos_db?schema=public
# Exemplo nuvem (Supabase / Neon): postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lobos_outlet?schema=public"

# 2. APLICAÇÃO NEXT.JS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="sua-chave-secreta-de-producao-gerada-com-openssl"

# 3. GATEWAY DE PAGAMENTO (Pix Dinâmico e Cartão de Crédito)
# Mercado Pago ou Asaas
MERCADO_PAGO_PUBLIC_KEY="APP_USR-xxxx-xxxx-xxxx"
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-xxxx-xxxx-xxxx"
MERCADO_PAGO_WEBHOOK_SECRET="seu-segredo-de-webhook"

# 4. NOTIFICAÇÕES WHATSAPP (Evolution API ou Z-API)
WHATSAPP_API_URL="https://api.exemplo.com"
WHATSAPP_API_KEY="seu-token-whatsapp"
WHATSAPP_INSTANCE_ID="lobos-outlet-01"
WHATSAPP_STORE_PHONE="5562999999999"

# 5. DADOS DA LOJA FÍSICA (Retirada e Contato)
NEXT_PUBLIC_STORE_NAME="Lobos G Outlet"
NEXT_PUBLIC_STORE_CITY="Goiânia - GO"
NEXT_PUBLIC_STORE_NEIGHBORHOOD="Jardim Novo Mundo"
NEXT_PUBLIC_STORE_WHATSAPP="5562999999999"
NEXT_PUBLIC_STORE_INSTAGRAM="https://www.instagram.com/lobosg.outlet"
